class Contabancaria {
    private string $titular;
    private float $saldo;
    
    public function __construct(string $titular, float $saldoinicial){
        $this->titular = $titular;
        $this->saldo = $saldoinicial;
    }
    
    public function depositar(float $valor): void {
        if ($valor > 0){
            $this->saldo += $valor;
        }
    }
    
    public function sacar(float $valor): void {
        if ($valor > 0 && $valor <= $this->saldo) {
            $this->saldo -= $valor;
        }   else {
            echo "saque de R$ {$valor} recusado: saldo insulfisiente ou valor ivalido.\n";
        }
    }
    public function getsaldo(): float {
        return $this->saldo;
    }
}

$conta = new Contabancaria("cleriston", 3543.00);

$conta->depositar(300.00);
$conta->sacar(376.00);
$conta->sacar(6000.00);

echo "Saldo atual: R$ " . $conta->getsaldo() . "\n";
